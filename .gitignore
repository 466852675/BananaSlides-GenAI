# =============================================================================
# BananaSlides-GenAI .gitignore (精简版)
# =============================================================================

# --- 依赖 ---
node_modules/
.pnpm-store/
.yarn/
.pnp.*

# --- 构建产物 & 缓存 ---
dist/
dist-ssr/
.vite/
.turbo/
.parcel-cache/
.rollup.cache/
.webpack/
*.tsbuildinfo
*.eslintcache

# --- 环境配置 (API密钥等敏感信息) ---
.env
.env.*
!.env.example
!.env.*.example
*.local

# --- 数据库 & 存储 ---
*.db*
*.bak*
*.backup
server/uploads/*
!server/uploads/.gitkeep

# --- 测试产物 ---
coverage/
.nyc_output/
test-results/
playwright-report/

# --- 编辑器/IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
*.sw[op]
*~
.history/
.ionide/

# --- AI 工具 & 工作流 ---
.claude/
CLAUDE.md
.agent/
.trae/
.recode/
.opencode/
.omc/
openspec/
contexts/
.spec-workflow/

# --- 日志 & 临时文件 ---
logs/
*.log*
*.tmp*
.tmp*/
*.pid

# --- 部署 & Docker ---
.vercel/
.vercel_build_output/
.netlify/
.wrangler/
docker-compose.override.yml
.docker/

# --- 安全 (证书/密钥) ---
*.pem
*.key

# --- 操作系统文件 ---
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- 项目特定 ---
scripts/*.bat
scripts/*.ps1
scripts/*.sh
docs/
image/
public/assets/showcase/
.debug/
.playwright-mcp/