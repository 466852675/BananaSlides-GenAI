generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(uuid())
  email              String?              @unique
  phone              String?              @unique
  username           String?              @unique
  passwordHash       String?
  nickname           String?
  avatar             String?
  bio                String?
  role               UserRole             @default(USER)
  status             UserStatus           @default(ACTIVE)
  points             Int                  @default(30)
  pointsUsed         Int                  @default(0)
  vipLevel           Int                  @default(0)
  vipExpiresAt       DateTime?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  loginFailCount     Int                  @default(0)
  lockedUntil        DateTime?
  resetCode          String?
  resetCodeExp       DateTime?
  inviteCode         String?              @unique
  invitedById        String?
  checkInDate        DateTime?
  checkInStreak      Int                  @default(0)
  riskScore          Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  checkInLogs        CheckInLog[]
  favorites          Favorite[]
  assignedLeads      Lead[]               @relation("LeadAssignee")
  leads              Lead[]
  orders             Order[]
  createdPointsRules PointsRule[]         @relation("RuleCreator")
  createdProducts    Product[]            @relation("ProductCreator")
  projects           Project[]
  refundRequests     RefundRequest[]
  socialAccounts     SocialAccount[]
  styleTemplates     StyleTemplate[]
  transactions       Transaction[]
  invitedBy          User?                @relation("Referrals", fields: [invitedById], references: [id])
  referrals          User[]               @relation("Referrals")
  handledMessages    UserMessage[]        @relation("MessageHandler")
  messages           UserMessage[]
  messageSettings    UserMessageSettings?
  refundStats        UserRefundStats?

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model SocialAccount {
  id          String   @id @default(uuid())
  userId      String
  provider    String
  providerId  String
  accessToken String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

model PointsRule {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  description       String?
  module            String?
  category          String?
  costPoints        Int
  costType          String   @default("fixed")
  calculationMethod String?
  deductionLogic    String?
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  effectiveAt       DateTime @default(now())
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  vipCostPoints     Int?
  createdBy         User?    @relation("RuleCreator", fields: [createdById], references: [id])
}

model Transaction {
  id          String    @id @default(uuid())
  userId      String
  type        String
  amount      Int
  balance     Int
  ruleCode    String?
  projectId   String?
  orderId     String?
  operatorId  String?
  description String?
  createdAt   DateTime  @default(now())
  category    String?
  module      String?
  subcategory String?
  triggerTime DateTime?
  templateId  String?
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([completedAt])
  @@index([userId, completedAt])
}

model Order {
  id             String          @id @default(uuid())
  orderNo        String          @unique
  userId         String
  productType    String
  productName    String
  productDesc    String?
  quantity       Int             @default(1)
  originalPrice  Float
  discountPrice  Float?
  finalPrice     Float
  status         OrderStatus     @default(PENDING)
  paymentMethod  String?
  paymentNo      String?
  paidAt         DateTime?
  refundReason   String?
  refundedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  fulfillmentAt  DateTime?
  productId      String?
  beforeVipLevel Int?
  afterVipLevel  Int?
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  refundRequests RefundRequest[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  module          String
  description     String?
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  role         UserRole
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

model Project {
  id           String            @id @default(uuid())
  title        String
  displayId    String?
  status       String            @default("idle")
  isPinned     Boolean           @default(false)
  isDeleted    Boolean           @default(false)
  deletedAt    DateTime?
  deletedBy    String?
  scenarioType String            @default("BUSINESS")
  globalConfig String
  styleMap     String?
  thumbnailUrl String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now())
  completedAt  DateTime?
  userId       String?
  agentSession AgentSession?
  assets       AssetRegistry[]
  user         User?             @relation(fields: [userId], references: [id])
  snapshots    ProjectSnapshot[]
  items        Slide[]

  @@index([userId])
  @@index([createdAt])
  @@index([isDeleted])
  @@index([deletedAt])
}

model ProjectSnapshot {
  id        String   @id @default(uuid())
  projectId String
  version   Int
  summary   String?
  data      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Slide {
  id              String   @id @default(uuid())
  projectId       String
  index           Int
  pageType        String
  contentType     String
  title           String
  content         String
  brief           String?
  variants        String   @default("[]")
  variantCount    Int      @default(2)
  previewUrl      String?
  originalFileRef String?
  status          String   @default("idle")
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model StyleTemplate {
  id             String     @id @default(uuid())
  name           String
  thumbnailUrl   String?
  config         String
  styleMap       String?
  isCustom       Boolean    @default(true)
  isOfficial     Boolean    @default(false)
  isRecommended  Boolean    @default(false)
  usageCount     Int        @default(0)
  favoriteCount  Int        @default(0)
  recommendCount Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  userId         String?
  favorites      Favorite[]
  user           User?      @relation(fields: [userId], references: [id])
}

model Favorite {
  id           String         @id @default(uuid())
  templateId   String?
  name         String
  config       String
  styleMap     String?
  sampleImages String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  userId       String?
  user         User?          @relation(fields: [userId], references: [id])
  template     StyleTemplate? @relation(fields: [templateId], references: [id])
}

model AppSettings {
  id        String   @id @default("global")
  config    String
  updatedAt DateTime @updatedAt
}

model GlobalConfig {
  key       String   @id
  value     String
  category  String?
  desc      String?
  updatedAt DateTime @updatedAt
}

model AiEngineRule {
  id          String   @id @default(uuid())
  name        String
  provider    String
  config      String
  isActive    Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model Product {
  id            String    @id @default(uuid())
  type          String
  name          String
  originalPrice Float?
  price         Float
  points        Int
  tags          String?
  features      String?
  roleToGrant   String?
  displayType   String    @default("public")
  period        String    @default("once")
  desc          String?
  discountEnd   DateTime?
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdById   String?
  effectiveAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     User?     @relation("ProductCreator", fields: [createdById], references: [id])
}

model CheckInLog {
  id        String   @id @default(uuid())
  userId    String
  date      String
  points    Int
  streak    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([createdAt])
}

model Lead {
  id               String         @id @default(uuid())
  userId           String?
  name             String
  company          String?
  position         String?
  phone            String
  email            String?
  teamSize         String?
  industry         String?
  needs            String?
  status           String         @default("PENDING")
  priority         String?        @default("MEDIUM")
  assigneeId       String?
  nextFollowUpAt   DateTime?
  source           String?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  convertedOrderId String?
  assignee         User?          @relation("LeadAssignee", fields: [assigneeId], references: [id])
  user             User?          @relation(fields: [userId], references: [id])
  activities       LeadActivity[]
}

model LeadActivity {
  id         String   @id @default(uuid())
  leadId     String
  type       String
  content    String
  metadata   String?
  operatorId String
  createdAt  DateTime @default(now())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  type      String
  content   String?
  reason    String?
  severity  String
  metadata  String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([severity])
  @@index([createdAt])
}

model RefundRequest {
  id               String           @id @default(uuid())
  refundNo         String           @unique
  userId           String
  orderId          String
  amount           Float
  status           RefundStatus     @default(PENDING)
  reason           String
  description      String?
  remark           String?
  processedAt      DateTime?
  completedAt      DateTime?
  processedBy      String?
  secondApprovedBy String?
  failReason       String?
  exceptionType    String?
  requireManualAt  DateTime?
  transactionId    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  history          RefundHistory[]
  order            Order            @relation(fields: [orderId], references: [id])
  user             User             @relation(fields: [userId], references: [id])
  retryLogs        RefundRetryLog[]

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model RefundHistory {
  id        String        @id @default(uuid())
  refundId  String
  action    String
  operator  String
  note      String?
  createdAt DateTime      @default(now())
  refund    RefundRequest @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([refundId])
}

model UserRefundStats {
  userId        String    @id
  totalRequests Int       @default(0)
  approvedCount Int       @default(0)
  rejectedCount Int       @default(0)
  lastRequestAt DateTime?
  riskScore     Int       @default(0)
  user          User      @relation(fields: [userId], references: [id])

  @@index([riskScore])
}

model RefundRetryLog {
  id            String        @id @default(uuid())
  refundId      String
  retryCount    Int
  error         String?
  scheduledAt   DateTime
  executedAt    DateTime?
  createdAt     DateTime      @default(now())
  refundRequest RefundRequest @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([refundId])
  @@index([scheduledAt])
}

model BenefitRevokeLog {
  id        String   @id @default(uuid())
  userId    String
  refundId  String
  revokedAt DateTime @default(now())
  reason    String

  @@index([userId])
  @@index([refundId])
}

model UserMessage {
  id           String      @id @default(uuid())
  userId       String
  type         MessageType
  title        String
  content      String
  summary      String?
  bizType      String?
  bizId        String?
  actionUrl    String?
  isRead       Boolean     @default(false)
  readAt       DateTime?
  isImportant  Boolean     @default(false)
  isDeleted    Boolean     @default(false)
  isArchived   Boolean     @default(false)
  archivedAt   DateTime?
  handledBy    String?
  handledAt    DateTime?
  handleAction String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  expiresAt    DateTime?
  handler      User?       @relation("MessageHandler", fields: [handledBy], references: [id])
  user         User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([isArchived])
  @@index([bizType])
  @@index([createdAt])
  @@index([handledBy])
  @@index([expiresAt])
}

model MessageTemplate {
  id        String      @id @default(uuid())
  code      String      @unique
  name      String
  type      MessageType
  title     String
  content   String
  bizType   String
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model UserMessageSettings {
  userId         String   @id
  emailEnabled   Boolean  @default(true)
  browserEnabled Boolean  @default(true)
  preferences    String   @default("{}")
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentSession {
  id              String             @id @default(cuid())
  projectId       String             @unique
  status          AgentSessionStatus @default(ACTIVE)
  mode            AgentMode          @default(GUIDED)
  isDeleted       Boolean            @default(false)
  deletedAt       DateTime?
  context         String?
  totalTasks      Int                @default(0)
  completedTasks  Int                @default(0)
  failedTasks     Int                @default(0)
  totalPointsUsed Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  completedAt     DateTime?
  messages        AgentMessage[]
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks           AgentTask[]
  assets          AssetRegistry[]

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([isDeleted])
}

model AgentMessage {
  id        String       @id @default(cuid())
  sessionId String
  role      String
  content   String
  toolCalls String?
  metadata  String?
  isEdited  Boolean      @default(false)
  editedAt  DateTime?
  isDeleted Boolean      @default(false)
  createdAt DateTime     @default(now())
  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@index([role])
  @@index([sessionId, createdAt])
}

model AgentTask {
  id          String          @id @default(cuid())
  sessionId   String
  type        AgentTaskType
  status      AgentTaskStatus @default(PENDING)
  priority    Int             @default(0)
  params      String?
  result      String?
  progress    Int             @default(0)
  error       String?
  retryCount  Int             @default(0)
  pointsCost  Int?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  session     AgentSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([createdAt])
  @@index([sessionId, status])
  @@index([status, priority])
}

model AssetRegistry {
  id            String        @id @default(cuid())
  projectId     String?
  sessionId     String?
  taskId        String?
  templateId    String?
  favoriteId    String?
  isReferenced  Boolean       @default(false)
  isOfficial    Boolean       @default(false)
  type          AssetType
  status        AssetStatus   @default(ACTIVE)
  filename      String
  url           String
  mimeType      String?
  sizeBytes     Int?
  metadata      String?
  pointsCost    Int?
  accessedAt    DateTime      @default(now())
  accessedCount Int           @default(0)
  expiresAt     DateTime?
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  session       AgentSession? @relation(fields: [sessionId], references: [id])
  project       Project?      @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([sessionId])
  @@index([templateId])
  @@index([favoriteId])
  @@index([type])
  @@index([status])
  @@index([isReferenced])
  @@index([isOfficial])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([deletedAt])
}

enum UserRole {
  USER
  BASIC
  PROFESSIONAL
  PREMIUM
  ENTERPRISE
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  FAILED
}

enum RefundStatus {
  PENDING
  PENDING_SECOND
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
  MANUAL_REQUIRED
}

enum MessageType {
  SYSTEM
  ORDER
  REFUND
  AI
  POINTS
  VIP
  ACTIVITY
  SECURITY
  LEAD
}

enum AgentSessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentMode {
  GUIDED
  AUTO
}

enum AgentTaskType {
  CONFIG_CONFIRM
  OUTLINE
  CONTENT
  IMAGE
  IMAGE_BY_PAGE
  FINAL_OVERVIEW
  EXPORT
  IMPORT
  MODIFY
  STYLE
  SNAPSHOT
}

enum AgentTaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AssetType {
  IMAGE
  TEMPLATE_IMAGE
  FAVORITE_IMAGE
  USER_UPLOAD
  OUTLINE
  EXPORT_ZIP
  EXPORT_PDF
  EXPORT_PPTX
  DOCUMENT
  THUMBNAIL
}

enum AssetStatus {
  ACTIVE
  TRASHED
  ARCHIVED
  DELETED
}
