generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String          @id @default(uuid())
  email              String?         @unique
  phone              String?         @unique
  username           String?         @unique
  passwordHash       String?
  nickname           String?
  avatar             String?
  bio                String?
  role               UserRole        @default(USER)
  status             UserStatus      @default(ACTIVE)
  points             Int             @default(30)
  pointsUsed         Int             @default(0)
  vipLevel           Int             @default(0)
  vipExpiresAt       DateTime?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  loginFailCount     Int             @default(0)
  lockedUntil        DateTime?
  resetCode          String?
  resetCodeExp       DateTime?
  inviteCode         String?         @unique
  invitedById        String?
  checkInDate        DateTime?
  checkInStreak      Int             @default(0)
  riskScore          Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  checkInLogs        CheckInLog[]
  favorites          Favorite[]
  leads              Lead[]
  orders             Order[]
  createdPointsRules PointsRule[]    @relation("RuleCreator")
  createdProducts    Product[]       @relation("ProductCreator")
  projects           Project[]
  socialAccounts     SocialAccount[]
  styleTemplates     StyleTemplate[]
  transactions       Transaction[]
  invitedBy          User?           @relation("Referrals", fields: [invitedById], references: [id])
  referrals          User[]          @relation("Referrals")
  refundRequests     RefundRequest[]
  refundStats        UserRefundStats?
  messages           UserMessage[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model SocialAccount {
  id          String   @id @default(uuid())
  userId      String
  provider    String
  providerId  String
  accessToken String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

model PointsRule {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  description       String?
  module            String?
  category          String?
  costPoints        Int
  costType          String   @default("fixed")
  calculationMethod String?
  deductionLogic    String?
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  effectiveAt       DateTime @default(now())
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  vipCostPoints     Int?
  createdBy         User?    @relation("RuleCreator", fields: [createdById], references: [id])
}

model Transaction {
  id          String    @id @default(uuid())
  userId      String
  type        String
  amount      Int
  balance     Int
  ruleCode    String?
  projectId   String?
  orderId     String?
  operatorId  String?
  description String?
  createdAt   DateTime  @default(now())
  category    String?
  module      String?
  subcategory String?
  triggerTime DateTime?
  templateId  String?
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Order {
  id            String      @id @default(uuid())
  orderNo       String      @unique
  userId        String
  productType   String
  productName   String
  productDesc   String?
  quantity      Int         @default(1)
  originalPrice Float
  discountPrice Float?
  finalPrice    Float
  status        OrderStatus @default(PENDING)
  paymentMethod String?
  paymentNo     String?
  paidAt        DateTime?
  refundReason  String?
  refundedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  fulfillmentAt DateTime?
  productId     String?
  beforeVipLevel Int?
  afterVipLevel  Int?
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  refundRequests RefundRequest[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  module          String
  description     String?
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  role         UserRole
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

model Project {
  id           String            @id @default(uuid())
  title        String
  displayId    String?
  status       String            @default("idle")
  isPinned     Boolean           @default(false)
  scenarioType String            @default("BUSINESS")
  globalConfig String
  styleMap     String?
  thumbnailUrl String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now())
  completedAt  DateTime?
  userId       String?
  user         User?             @relation(fields: [userId], references: [id])
  snapshots    ProjectSnapshot[]
  items        Slide[]

  @@index([userId])
  @@index([createdAt])
}

model ProjectSnapshot {
  id        String   @id @default(uuid())
  projectId String
  version   Int
  summary   String?
  data      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Slide {
  id              String   @id @default(uuid())
  projectId       String
  index           Int
  pageType        String
  contentType     String
  title           String
  content         String
  brief           String?
  variants        String   @default("[]")
  variantCount    Int      @default(2)
  previewUrl      String?
  originalFileRef String?
  status          String   @default("idle")
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model StyleTemplate {
  id             String     @id @default(uuid())
  name           String
  config         String
  styleMap       String?
  isCustom       Boolean    @default(true)
  isOfficial     Boolean    @default(false)
  isRecommended  Boolean    @default(false)
  usageCount     Int        @default(0)
  favoriteCount  Int        @default(0)
  recommendCount Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  userId         String?
  favorites      Favorite[]
  user           User?      @relation(fields: [userId], references: [id])
}

model Favorite {
  id           String         @id @default(uuid())
  templateId   String?
  name         String
  config       String
  styleMap     String?
  sampleImages String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  userId       String?
  user         User?          @relation(fields: [userId], references: [id])
  template     StyleTemplate? @relation(fields: [templateId], references: [id])
}

model AppSettings {
  id        String   @id @default("global")
  config    String
  updatedAt DateTime @updatedAt
}

model GlobalConfig {
  key       String   @id
  value     String
  category  String?
  desc      String?
  updatedAt DateTime @updatedAt
}

model Product {
  id            String    @id @default(uuid())
  type          String
  name          String
  originalPrice Float?
  price         Float
  points        Int
  tags          String?
  features      String?
  roleToGrant   String?
  displayType   String    @default("public")
  period        String    @default("once")
  desc          String?
  discountEnd   DateTime?
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdById   String?
  effectiveAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     User?     @relation("ProductCreator", fields: [createdById], references: [id])
}

model CheckInLog {
  id        String   @id @default(uuid())
  userId    String
  date      String
  points    Int
  streak    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([createdAt])
}

model Lead {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  company   String?
  position  String?
  phone     String
  email     String?
  teamSize  String?
  industry  String?
  needs     String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     String?
  source    String?
  user      User?    @relation(fields: [userId], references: [id])
}

enum UserRole {
  USER
  BASIC
  PROFESSIONAL
  PREMIUM
  ENTERPRISE
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  FAILED
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  type      String
  content   String?
  reason    String?
  severity  String
  metadata  String?
   ip        String?
   createdAt DateTime @default(now())

   @@index([userId])
   @@index([type])
   @@index([severity])
   @@index([createdAt])
}

// ============================================================
// 退款管理模块
// ============================================================

enum RefundStatus {
  PENDING
  PENDING_SECOND
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
  MANUAL_REQUIRED
}

model RefundRequest {
  id                String       @id @default(uuid())
  refundNo          String       @unique
  userId            String
  orderId           String
  amount            Float
  status            RefundStatus @default(PENDING)
  reason            String
  description       String?
  remark            String?
  
  // 处理信息
  processedAt       DateTime?
  completedAt       DateTime?
  processedBy       String?
  secondApprovedBy  String?
  
  // 异常处理
  failReason        String?
  exceptionType     String?
  requireManualAt   DateTime?
  
  // 退款交易信息
  transactionId     String?
  
  // 时间戳
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  
  // 关联
  user              User         @relation(fields: [userId], references: [id])
  order             Order        @relation(fields: [orderId], references: [id])
  
  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model UserRefundStats {
  userId            String    @id
  totalRequests     Int       @default(0)
  approvedCount     Int       @default(0)
  rejectedCount     Int       @default(0)
  lastRequestAt     DateTime?
  riskScore         Int       @default(0)
  user              User      @relation(fields: [userId], references: [id])
  
  @@index([riskScore])
}

model RefundRetryLog {
  id          String    @id @default(uuid())
  refundId    String
  retryCount  Int
  error       String?
  scheduledAt DateTime
  executedAt  DateTime?
  
  @@index([refundId])
  @@index([scheduledAt])
}

model BenefitRevokeLog {
  id          String   @id @default(uuid())
  userId      String
  refundId    String
  revokedAt   DateTime @default(now())
  reason      String

  @@index([userId])
  @@index([refundId])
}

// ============================================================
// 消息中心模块 - 站内信系统
// ============================================================

enum MessageType {
  SYSTEM
  ORDER
  REFUND
  AI
  POINTS
  VIP
  ACTIVITY
  SECURITY
}

model UserMessage {
  id            String      @id @default(uuid())
  userId        String
  type          MessageType
  title         String
  content       String
  summary       String?

  bizType       String?
  bizId         String?
  actionUrl     String?

  isRead        Boolean     @default(false)
  readAt        DateTime?
  isImportant   Boolean     @default(false)
  isDeleted     Boolean     @default(false)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([bizType])
  @@index([createdAt])
}

model MessageTemplate {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  type        MessageType
  title       String
  content     String
  bizType     String
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}
