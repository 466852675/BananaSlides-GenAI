# ============================================
# YH-AI 智能PPT创作平台 服务端配置模板
# 复制此文件为 .env 并按需填写
# ============================================

# --- 运行环境 ---
# development: 限流被跳过，适用于本地开发
# production:  启用完整限流和安全策略，生产部署必须设置
NODE_ENV=development

# --- 服务端口 ---
PORT=1111

# --- 数据库 ---
DATABASE_URL="file:./dev.db"

# --- JWT 安全 (必需) ---
# 用于 JWT Token 签发与验证，至少 32 个字符
# 生成命令: openssl rand -base64 32
JWT_SECRET="your-256-bit-secret-minimum-32-characters-long"
JWT_EXPIRES_IN="7d"

# --- CORS 安全 (必需) ---
# 允许的跨域请求来源，按实际部署地址调整
ALLOWED_ORIGINS="http://localhost:1000,http://localhost:5173,http://127.0.0.1:1000"

# --- Bootstrap 管理员初始化 (可选) ---
# 首次启动时自动创建管理员账号，未设置则使用默认值
# BOOTSTRAP_ADMIN_EMAIL="admin@local"
# BOOTSTRAP_ADMIN_USERNAME="admin"
# BOOTSTRAP_ADMIN_PASSWORD="admin12345678"
# BOOTSTRAP_ADMIN_TAKE_OVER="1"   # 设为 "1" 时接管无主数据（用户注销后项目转移给管理员）

# ============================================
# AI 模型配置
# ⚠️ 重要说明: 以下 AI 配置仅在首次启动（数据库为空时）作为初始种子写入数据库。
# 之后运行时以管理后台（系统设置 → AI核心引擎）中的配置为准。
# 修改此文件后不会自动生效，需在管理后台点击"重置为默认"或删除 dev.db 重建。
# ============================================

# --- AI 提供商选择 ---
# 可选值: Gemini, OpenAI, Zhipu, SiliconFlow, ModelScope, Custom, CustomCombo
AI_PROVIDER="Gemini"

# 全局默认基础地址 (未指定特定提供商地址时的回退)
AI_BASE_URL="https://generativelanguage.googleapis.com"

# --- Google Gemini ---
GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
GEMINI_API_KEY=""
GEMINI_MODEL_TEXT="gemini-3-flash"
GEMINI_MODEL_IMAGE="gemini-3-pro-image"
GEMINI_MODEL_VISION="gemini-3-flash"

# --- OpenAI (及兼容协议) ---
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=""
OPENAI_MODEL_TEXT="gpt-4-turbo"
OPENAI_MODEL_IMAGE="dall-e-3"
OPENAI_MODEL_VISION="gpt-4-vision-preview"

# --- 智谱 AI ---
ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
ZHIPU_API_KEY=""
ZHIPU_MODEL_TEXT="glm-4"
ZHIPU_MODEL_IMAGE="cogview-3"
ZHIPU_MODEL_VISION="glm-4v"

# --- SiliconFlow (硅基流动) ---
SILICON_BASE_URL="https://api.siliconflow.cn/v1"
SILICON_API_KEY=""
SILICON_MODEL_TEXT="deepseek-ai/DeepSeek-V2.5"
SILICON_MODEL_IMAGE="black-forest-labs/FLUX.1-schnell"
SILICON_MODEL_VISION="deepseek-ai/DeepSeek-V2.5"

# --- ModelScope (魔搭社区) ---
MODELSCOPE_BASE_URL="https://api-inference.modelscope.cn/v1"
MODELSCOPE_API_KEY=""
MODELSCOPE_MODEL_TEXT="qwen-max"
MODELSCOPE_MODEL_IMAGE="wanx-v1"
MODELSCOPE_MODEL_VISION="qwen-vl-max"

# --- Volcengine (火山引擎) ---
VOLCENGINE_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
VOLCENGINE_API_KEY=""
# 注意: 模型名需填写控制台创建的推理接入点 ID (如 ep-20250121xxx-abcde)
VOLCENGINE_MODEL_TEXT=""
VOLCENGINE_MODEL_IMAGE=""
VOLCENGINE_MODEL_VISION=""

# --- Custom (完全自定义) ---
CUSTOM_BASE_URL=""
CUSTOM_API_KEY=""
CUSTOM_MODEL_TEXT=""
CUSTOM_MODEL_IMAGE=""
CUSTOM_MODEL_VISION=""

# --- 自定义组合模式 (AI_PROVIDER="CustomCombo" 时生效) ---
# 允许为不同任务指定不同的模型/服务商
# COMBO_TEXT_BASE=""
# COMBO_TEXT_KEY=""
# COMBO_TEXT_MODEL="gemini-3-flash"
# COMBO_IMAGE_BASE=""
# COMBO_IMAGE_KEY=""
# COMBO_IMAGE_MODEL="gemini-3-pro-image"
# COMBO_VISION_BASE=""
# COMBO_VISION_KEY=""
# COMBO_VISION_MODEL="gemini-3-flash"

# --- 图像生成配置 ---
IMG_RESOLUTION="2048x2048"

# --- 性能并发配置 ---
PERF_TEXT_CONCURRENCY=1
PERF_IMAGE_CONCURRENCY=1

# --- 输出语言 ---
# 可选值: zh (中文), en (英文), ja (日文), auto (自动)
OUTPUT_LANGUAGE="zh"

# --- AI Mock 模式 (可选，调试用) ---
# 设为 "true" 时跳过真实 AI 调用，返回模拟结果
# MOCK_AI="true"

# ============================================
# 文档解析服务
# ============================================

DOC_PARSER_PROVIDER="MinerU"
DOC_PARSER_BASE="https://mineru.net"
# DOC_PARSER_KEY=""

# ============================================
# 支付系统配置 (企业模式，个人模式可忽略)
# ============================================

# --- 微信支付 ---
# WECHAT_MCH_ID=""
# WECHAT_APP_ID=""
# WECHAT_API_KEY=""
# WECHAT_CERT_PATH="./certs/wechat/apiclient_cert.pem"
# WECHAT_KEY_PATH="./certs/wechat/apiclient_key.pem"
# WECHAT_SERIAL_NO=""
# WECHAT_MOCK_MODE="true"       # 修改后需重启服务（模块加载时固化）

# --- 支付宝 ---
# ALIPAY_APP_ID=""
# ALIPAY_PRIVATE_KEY=""
# ALIPAY_PUBLIC_KEY=""
# ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"
# ALIPAY_ENCRYPT_KEY=""
# ALIPAY_MOCK_MODE="true"        # 修改后需重启服务（模块加载时固化）

# ============================================
# 邮件与运营 (可选)
# ============================================

# --- 邮件服务 ---
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""

# --- 客服邮箱 ---
# SUPPORT_EMAIL="support@bananaslides.com"

# --- 邮件开发模式 ---
# 设为 "true" 时验证码输出到控制台而非发送邮件
# MAIL_DEV_MODE="true"

# --- 积分汇率 (退款功能使用) ---
# POINTS_TO_YUAN_RATE=0.1
