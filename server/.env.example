# Server Configuration
PORT=1111
NODE_ENV=development

# Database
DATABASE_URL="file:./dev.db"

# JWT Security (REQUIRED - min 32 chars)
# Generate: openssl rand -base64 32
JWT_SECRET="your-256-bit-secret-minimum-32-characters-long"
JWT_EXPIRES_IN="7d"

# CORS Security
ALLOWED_ORIGINS="http://localhost:1000,http://localhost:5173,http://127.0.0.1:1000"

# AI Providers
AI_PROVIDER="Volcengine"
COMBO_TEXT_MODEL="gemini-3-flash"
COMBO_IMAGE_MODEL="gemini-3-pro-image"
COMBO_VISION_MODEL="gemini-3-flash"

# Document Parsing
DOC_PARSER_BASE="https://mineru.net"
DOC_PARSER_PROVIDER="MinerU"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"

# Optional: Email Service
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""

# Optional: Payment
# PAYMENT_PROVIDER=""
# PAYMENT_KEY=""
# PAYMENT_SECRET=""
